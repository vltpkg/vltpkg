  "bugs": {
    "url": "https://github.com/vltpkg/vltpkg/issues"
  },
  "homepage": "https://github.com/vltpkg/vltpkg/tree/main/.#readme",
  "perry": {
    "$comment": "Third-party packages compiled into the binary. Every name here passed check -> compile -> run -> diff-against-Node in the Phase 2 dep loop. compilePackages is a build set, not an import filter, and it is not transitive.",
