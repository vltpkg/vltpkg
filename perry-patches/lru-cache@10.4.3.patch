 /* c8 ignore stop */
-class ZeroArray extends Array {
-    constructor(size) {
-        super(size);
-        this.fill(0);
-    }
-}
+// perry: `class X extends Array` produces a non-Array object — Array.isArray
+// is false, prototype methods are missing, and growing it by index throws
+// `Cannot assign to read only property`. A factory returning a real Array is
+// identical under node, including through `new`.
+const ZeroArray = function (size) {
+    return new Array(size).fill(0);
+};
