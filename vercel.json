{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet $VERCEL_GIT_PREVIOUS_SHA $VERCEL_GIT_COMMIT_SHA -- www/docs/",
  "outputDirectory": "www/docs/dist",
  "redirects": [
    {
      "source": "/migration/from-pnpm",
      "destination": "/cli/migration/from-pnpm",
      "permanent": true
    },
    {
      "source": "/migration/from-yarn",
      "destination": "/cli/migration/from-yarn",
      "permanent": true
    },
    {
      "source": "/migration/from-npm",
      "destination": "/cli/migration/from-npm",
      "permanent": true
    }
  ]
}
