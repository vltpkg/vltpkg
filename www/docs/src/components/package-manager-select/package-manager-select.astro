---
export interface Props {
  defaultValue?: string
  placeholder?: string
  className?: string
  syncKey?: string
}

const {
  defaultValue = 'vlt',
  placeholder = 'Select a package manager',
  className = '',
  syncKey = 'pkg-manager',
} = Astro.props

const svg = (path: string, viewBox = '0 0 24 24') =>
